const request = require('supertest');
const createApp = require('../../src/app');
const { pool } = require('../../src/config/db');
const { resetDatabase, registerAndLogin } = require('./helpers');

const app = createApp();

describe('Income routes (integration)', () => {
  let token;

  beforeEach(async () => {
    await resetDatabase();
    ({ token } = await registerAndLogin(request, app));
  });

  afterAll(async () => {
    await pool.end();
  });

  it('records a new income entry', async () => {
    const res = await request(app)
      .post('/api/income')
      .set('Authorization', `Bearer ${token}`)
      .send({ amount: 600, source: 'Part-time job', date: '2026-06-01' });

    expect(res.status).toBe(201);
    expect(res.body.data).toMatchObject({ source: 'Part-time job' });
    expect(Number(res.body.data.amount)).toBe(600);
  });

  it('returns 400 when source is missing', async () => {
    const res = await request(app)
      .post('/api/income')
      .set('Authorization', `Bearer ${token}`)
      .send({ amount: 600, date: '2026-06-01' });

    expect(res.status).toBe(400);
  });

  it('lists income sorted by most recent date first', async () => {
    await request(app)
      .post('/api/income')
      .set('Authorization', `Bearer ${token}`)
      .send({ amount: 100, source: 'Old', date: '2026-01-01' });
    await request(app)
      .post('/api/income')
      .set('Authorization', `Bearer ${token}`)
      .send({ amount: 200, source: 'Recent', date: '2026-06-01' });

    const res = await request(app).get('/api/income').set('Authorization', `Bearer ${token}`);

    expect(res.status).toBe(200);
    expect(res.body.data[0].source).toBe('Recent');
  });

  it('updates an owned income record', async () => {
    const createRes = await request(app)
      .post('/api/income')
      .set('Authorization', `Bearer ${token}`)
      .send({ amount: 100, source: 'Job', date: '2026-06-01' });

    const res = await request(app)
      .put(`/api/income/${createRes.body.data.id}`)
      .set('Authorization', `Bearer ${token}`)
      .send({ amount: 150 });

    expect(res.status).toBe(200);
    expect(Number(res.body.data.amount)).toBe(150);
  });
});
