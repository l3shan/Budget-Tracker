const request = require('supertest');
const createApp = require('../../src/app');
const { pool } = require('../../src/config/db');
const { resetDatabase, registerAndLogin } = require('./helpers');

const app = createApp();

describe('Expense routes (integration)', () => {
  let token;

  beforeEach(async () => {
    await resetDatabase();
    ({ token } = await registerAndLogin(request, app));
  });

  afterAll(async () => {
    await pool.end();
  });

  it('rejects unauthenticated requests', async () => {
    const res = await request(app).get('/api/expenses');
    expect(res.status).toBe(401);
  });

  it('creates an expense using a valid category name', async () => {
    const res = await request(app)
      .post('/api/expenses')
      .set('Authorization', `Bearer ${token}`)
      .send({ category: 'Food', amount: 45.5, description: 'Groceries', date: '2026-06-15' });

    expect(res.status).toBe(201);
    expect(res.body.data.category_id).toEqual(expect.any(Number));
    expect(Number(res.body.data.amount)).toBe(45.5);
  });

  it('returns 400 for an unknown category', async () => {
    const res = await request(app)
      .post('/api/expenses')
      .set('Authorization', `Bearer ${token}`)
      .send({ category: 'MadeUpCategory', amount: 10, date: '2026-06-15' });

    expect(res.status).toBe(400);
  });

  it('returns 400 for a negative amount', async () => {
    const res = await request(app)
      .post('/api/expenses')
      .set('Authorization', `Bearer ${token}`)
      .send({ category: 'Food', amount: -5, date: '2026-06-15' });

    expect(res.status).toBe(400);
  });

  it('lists expenses with their category name joined in', async () => {
    await request(app)
      .post('/api/expenses')
      .set('Authorization', `Bearer ${token}`)
      .send({ category: 'Transport', amount: 20, date: '2026-06-15' });

    const res = await request(app).get('/api/expenses').set('Authorization', `Bearer ${token}`);

    expect(res.status).toBe(200);
    expect(res.body.data[0].category_name).toBe('Transport');
  });

  it('returns 404 when another user tries to update the expense', async () => {
    const createRes = await request(app)
      .post('/api/expenses')
      .set('Authorization', `Bearer ${token}`)
      .send({ category: 'Food', amount: 20, date: '2026-06-15' });

    const { token: otherToken } = await registerAndLogin(request, app, { email: 'other@student.edu' });

    const res = await request(app)
      .put(`/api/expenses/${createRes.body.data.id}`)
      .set('Authorization', `Bearer ${otherToken}`)
      .send({ amount: 1 });

    expect(res.status).toBe(404);
  });

  it('deletes an owned expense', async () => {
    const createRes = await request(app)
      .post('/api/expenses')
      .set('Authorization', `Bearer ${token}`)
      .send({ category: 'Food', amount: 20, date: '2026-06-15' });

    const res = await request(app)
      .delete(`/api/expenses/${createRes.body.data.id}`)
      .set('Authorization', `Bearer ${token}`);

    expect(res.status).toBe(200);
  });
});

describe('Category routes (integration)', () => {
  let token;

  beforeAll(async () => {
    await resetDatabase();
    ({ token } = await registerAndLogin(request, app, { email: 'cat-user@student.edu' }));
  });

  it('returns the seeded default categories', async () => {
    const res = await request(app).get('/api/categories').set('Authorization', `Bearer ${token}`);
    expect(res.status).toBe(200);
    expect(res.body.data.map((c) => c.name)).toEqual(expect.arrayContaining(['Food', 'Transport']));
  });
});
